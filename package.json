{
  "name": "brace2",
  "version": "0.12.4",
  "description": "Browserify-compatible Ace Editor with inlined Web Workers and TypeScript declarations",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "ext/",
    "keybinding/",
    "mode/",
    "snippets/",
    "theme/",
    "worker/",
    "index.js",
    "index.d.ts",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "update": "(cd build && node ./update && node ./update-ts)",
    "build:test": "browserify test/error-annotations.js --debug --outfile test/bundle.js",
    "test": "npm run build:test",
    "test:browser": "npm test && opener test/index.html",
    "prepack": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budiselic/brace2.git"
  },
  "homepage": "https://github.com/budiselic/brace2",
  "bugs": {
    "url": "https://github.com/budiselic/brace2/issues"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "opener": "^1.5.2",
    "shelljs": "^0.10.0",
    "tape": "^5.10.2",
    "uglify-js": "^3.19.3"
  },
  "keywords": [
    "ace",
    "editor",
    "browser",
    "package",
    "bundle",
    "inline",
    "browserify",
    "web-worker",
    "typescript"
  ],
  "author": {
    "name": "Antonio Budiselic",
    "url": "https://github.com/budiselic"
  },
  "license": "MIT AND BSD-3-Clause"
}
